# Docker Compose
COMPOSE_PROJECT_NAME=evidenceforge

# PostgreSQL (local development only; replace before any shared deployment)
POSTGRES_DB=evidenceforge
POSTGRES_USER=evidenceforge
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://evidenceforge:change-me@postgres:5432/evidenceforge

# LocalStack emulates both S3-compatible storage and SQS.
S3_BUCKET=evidenceforge-local
AWS_ENDPOINT_URL=http://localstack:4566
AWS_REGION=us-east-1
SQS_QUEUE_NAME=research-runs

# Service endpoints
NEXT_PUBLIC_API_URL=http://localhost:8000
API_PORT=8000
WEB_PORT=3000
